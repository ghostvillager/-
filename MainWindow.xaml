<Window x:Class="SimpleMultiAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="複数デバイス同時再生"
        Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1e1e1e"
        Foreground="White"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        Icon="icon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="出力デバイスを選択" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <!-- デバイス一覧 -->
        <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Background="#2a2a2a">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DeviceList" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="4"
                                      Foreground="White"
                                      FontSize="13"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 状態 -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="準備完了" Margin="0,12,0,8" FontSize="12" Foreground="#aaa"/>

        <!-- ボタン（開始／更新は1つだけ） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnStart" Content="開始" Width="120" Height="32" Click="BtnStart_Click" Background="#0a84ff" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
